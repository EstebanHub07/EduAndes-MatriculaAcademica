{
  "info": {
    "_postman_id": "e8aa9f5d-3dcb-4ac8-93b5-eduandes-u1",
    "name": "EduAndes - Examen U1",
    "description": "Casos funcionales de la API EduAndes. Ejecutar datos_semilla.sql y ajustar las variables de identificadores antes de usarla.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "carreraSistemasId", "value": "1" },
    { "key": "estudianteAnaId", "value": "1" },
    { "key": "estudianteJorgeId", "value": "2" },
    { "key": "estudianteCarlosId", "value": "3" },
    { "key": "estudianteMariaId", "value": "4" },
    { "key": "cursoIS401Id", "value": "1" },
    { "key": "cursoIS402Id", "value": "2" },
    { "key": "cursoIS403Id", "value": "3" },
    { "key": "cursoIS501Id", "value": "4" },
    { "key": "cursoIS502Id", "value": "5" },
    { "key": "cursoIS503Id", "value": "6" },
    { "key": "cursoIC401Id", "value": "7" },
    { "key": "matriculaId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Listar carreras",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/carreras" }
    },
    {
      "name": "02 - Carrera duplicada normalizada",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"  ingeniería   de sistemas  \",\n  \"descripcion\": \"Duplicada\",\n  \"estado\": true\n}" },
        "url": "{{baseUrl}}/carreras"
      }
    },
    {
      "name": "03 - Curso con validaciones incorrectas",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));", "pm.test('Incluye validationErrors', () => pm.expect(pm.response.json().validationErrors).to.be.an('object'));" ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"is40\",\n  \"nombre\": \"X\",\n  \"creditos\": 7,\n  \"ciclo\": 11,\n  \"vacantes\": -1\n}" },
        "url": "{{baseUrl}}/cursos"
      }
    },
    {
      "name": "04 - Curso con carrera inexistente",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"IS499\",\n  \"nombre\": \"Curso sin carrera\",\n  \"creditos\": 3,\n  \"ciclo\": 4,\n  \"vacantes\": 10,\n  \"estado\": true,\n  \"carreraId\": 99\n}" },
        "url": "{{baseUrl}}/cursos"
      }
    },
    {
      "name": "05 - Buscar cursos combinando filtros",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('Todos tienen vacantes', () => pm.response.json().forEach(c => pm.expect(c.vacantes).to.be.above(0)));" ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/cursos/buscar?carreraId={{carreraSistemasId}}&ciclo=4&conVacantes=true&orden=vacantes&dir=desc"
      }
    },
    {
      "name": "06 - Registrar matrícula válida",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('matriculaId', pm.response.json().id);", "pm.test('11 créditos y S/ 1320.00', () => { const r = pm.response.json(); pm.expect(r.totalCreditos).to.eql(11); pm.expect(r.montoTotal).to.eql(1320); });" ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-2\",\n  \"estudianteId\": {{estudianteAnaId}},\n  \"detalles\": [\n    { \"cursoId\": {{cursoIS401Id}} },\n    { \"cursoId\": {{cursoIS402Id}} },\n    { \"cursoId\": {{cursoIS501Id}} }\n  ]\n}" },
        "url": "{{baseUrl}}/matriculas"
      }
    },
    {
      "name": "07 - Estudiante inactivo RN-01",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-2\",\n  \"estudianteId\": {{estudianteCarlosId}},\n  \"detalles\": [{ \"cursoId\": {{cursoIS401Id}} }]\n}" },
        "url": "{{baseUrl}}/matriculas"
      }
    },
    {
      "name": "08 - Curso de otra carrera RN-01",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-2\",\n  \"estudianteId\": {{estudianteMariaId}},\n  \"detalles\": [\n    { \"cursoId\": {{cursoIC401Id}} },\n    { \"cursoId\": {{cursoIS401Id}} }\n  ]\n}" },
        "url": "{{baseUrl}}/matriculas"
      }
    },
    {
      "name": "09 - Curso sin vacantes RN-02",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-2\",\n  \"estudianteId\": {{estudianteJorgeId}},\n  \"detalles\": [\n    { \"cursoId\": {{cursoIS403Id}} },\n    { \"cursoId\": {{cursoIS502Id}} }\n  ]\n}" },
        "url": "{{baseUrl}}/matriculas"
      }
    },
    {
      "name": "10 - Matrícula duplicada RN-03",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-2\",\n  \"estudianteId\": {{estudianteAnaId}},\n  \"detalles\": [{ \"cursoId\": {{cursoIS503Id}} }]\n}" },
        "url": "{{baseUrl}}/matriculas"
      }
    },
    {
      "name": "11 - Más de 20 créditos RN-04",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-2\",\n  \"estudianteId\": {{estudianteJorgeId}},\n  \"detalles\": [\n    { \"cursoId\": {{cursoIS401Id}} },\n    { \"cursoId\": {{cursoIS402Id}} },\n    { \"cursoId\": {{cursoIS403Id}} },\n    { \"cursoId\": {{cursoIS501Id}} },\n    { \"cursoId\": {{cursoIS503Id}} }\n  ]\n}" },
        "url": "{{baseUrl}}/matriculas"
      }
    },
    {
      "name": "12 - Reporte de matriculados por curso",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('Devuelve una lista', () => pm.expect(pm.response.json()).to.be.an('array'));" ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reportes/matriculados-por-curso?periodo=2026-2&carreraId={{carreraSistemasId}}"
      }
    },
    {
      "name": "13 - Anular matrícula",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('Estado ANULADA', () => pm.expect(pm.response.json().estado).to.eql('ANULADA'));" ] } }],
      "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/matriculas/{{matriculaId}}/anular" }
    },
    {
      "name": "14 - Repetir anulación",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/matriculas/{{matriculaId}}/anular" }
    }
  ]
}
